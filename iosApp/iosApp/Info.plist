<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- ATS: HTTP sin cifrar solo hacia la red local (servidor de desarrollo). Nunca NSAllowsArbitraryLoads. -->
