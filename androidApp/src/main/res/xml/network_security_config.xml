<?xml version="1.0" encoding="utf-8"?>
<!--
    Qué direcciones pueden usarse con HTTP sin cifrar (diapositiva 13).

    Desde Android 9 el HTTP sin cifrar está bloqueado por defecto. Se permite
    SOLO para el servidor de desarrollo; todo lo demás exige HTTPS.

    - 10.0.2.2   : el emulador de Android alcanza así el localhost de tu PC.
    - 127.0.0.1  : teléfono físico por USB con «adb reverse tcp:8000 tcp:8000».
    - localhost  : igual que 127.0.0.1.

    Teléfono físico por Wi-Fi: agrega aquí la IP de la computadora de la planta
    (la misma que escribes en el login de la app), por ejemplo:
        <domain includeSubdomains="false">192.168.1.50</domain>
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
