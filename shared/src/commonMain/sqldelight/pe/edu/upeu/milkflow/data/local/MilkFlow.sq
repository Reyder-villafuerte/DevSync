CREATE TABLE usuario_local (
    id TEXT NOT NULL PRIMARY KEY,
    nombre_usuario TEXT NOT NULL UNIQUE,
    nombre TEXT NOT NULL,
    rol TEXT NOT NULL,
    activo INTEGER NOT NULL,
    clave TEXT -- Agregado para persistencia local de credenciales
);

CREATE TABLE productor_local (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL,
    activo INTEGER NOT NULL
);

CREATE TABLE acopiador_local (
    id TEXT NOT NULL PRIMARY KEY,
    nombre TEXT NOT NULL
);

CREATE TABLE entrega_local (
    id TEXT NOT NULL PRIMARY KEY,
    productor_id TEXT NOT NULL REFERENCES productor_local(id),
    fecha_hora_epoch_millis INTEGER NOT NULL,
    litros REAL NOT NULL CHECK (litros > 0),
    tipo TEXT NOT NULL CHECK (tipo IN ('DIRECTA', 'RECOGIDA')),
    usuario_registro_id TEXT NOT NULL,
    estado_sincronizacion TEXT NOT NULL CHECK (estado_sincronizacion IN ('PENDIENTE', 'ENVIADO', 'ERROR')),
    acopiador_id TEXT REFERENCES acopiador_local(id),
    sector TEXT,
    CHECK (
        (tipo = 'DIRECTA' AND acopiador_id IS NULL AND sector IS NULL)
        OR
        (tipo = 'RECOGIDA' AND acopiador_id IS NOT NULL AND length(trim(sector)) > 0)
    )
);

CREATE INDEX entrega_productor_fecha_idx
ON entrega_local(productor_id, fecha_hora_epoch_millis);

CREATE INDEX entrega_fecha_idx
ON entrega_local(fecha_hora_epoch_millis);

CREATE TABLE prueba_calidad_local (
    id TEXT NOT NULL PRIMARY KEY,
    entrega_id TEXT NOT NULL REFERENCES entrega_local(id),
    fecha_hora_epoch_millis INTEGER NOT NULL
);

CREATE TABLE problema_leche_local (
    id TEXT NOT NULL PRIMARY KEY,
    entrega_id TEXT NOT NULL REFERENCES entrega_local(id),
    descripcion TEXT NOT NULL,
    fecha_hora_epoch_millis INTEGER NOT NULL
);

CREATE INDEX problema_entrega_idx
ON problema_leche_local(entrega_id);

CREATE TABLE auditoria_local (
    id TEXT NOT NULL PRIMARY KEY,
    usuario_id TEXT NOT NULL,
    fecha_hora_epoch_millis INTEGER NOT NULL,
    registro_afectado_id TEXT NOT NULL,
    accion TEXT NOT NULL
);

CREATE TABLE sincronizacion_local (
    tipo_registro TEXT NOT NULL,
    registro_id TEXT NOT NULL,
    estado TEXT NOT NULL CHECK (estado IN ('PENDIENTE', 'ENVIADO', 'ERROR')),
    PRIMARY KEY (tipo_registro, registro_id)
);

CREATE TABLE lote_produccion_local (
    id TEXT NOT NULL PRIMARY KEY,
    fecha_hora_epoch_millis INTEGER NOT NULL,
    litros_utilizados REAL NOT NULL,
    moldes_obtenidos INTEGER NOT NULL,
    tipo_producto TEXT NOT NULL,
    observaciones TEXT
);

guardarUsuario:
INSERT INTO usuario_local(id, nombre_usuario, nombre, rol, activo, clave)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    nombre_usuario = excluded.nombre_usuario,
    nombre = excluded.nombre,
    rol = excluded.rol,
    activo = excluded.activo;

obtenerUsuarioPorId:
SELECT id, nombre_usuario, nombre, rol, activo
FROM usuario_local
WHERE id = ?;

obtenerUsuarioPorNombre:
SELECT id, nombre_usuario, nombre, rol, activo
FROM usuario_local
WHERE nombre_usuario = ?;

obtenerUsuarioPorNombreConClave:
SELECT id, nombre_usuario, nombre, rol, activo, clave
FROM usuario_local
WHERE nombre_usuario = ?;

obtenerUsuarios:
SELECT id, nombre_usuario, nombre, rol, activo
FROM usuario_local
ORDER BY nombre;

guardarProductor:
INSERT INTO productor_local(id, nombre, activo)
VALUES (?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    nombre = excluded.nombre,
    activo = excluded.activo;

obtenerProductorPorId:
SELECT id, nombre, activo
FROM productor_local
WHERE id = ?;

obtenerProductores:
SELECT id, nombre, activo
FROM productor_local
ORDER BY nombre;

guardarAcopiador:
INSERT INTO acopiador_local(id, nombre)
VALUES (?, ?)
ON CONFLICT(id) DO UPDATE SET nombre = excluded.nombre;

obtenerAcopiadorPorId:
SELECT id, nombre
FROM acopiador_local
WHERE id = ?;

obtenerAcopiadores:
SELECT id, nombre
FROM acopiador_local
ORDER BY nombre;

guardarEntrega:
INSERT INTO entrega_local(
    id,
    productor_id,
    fecha_hora_epoch_millis,
    litros,
    tipo,
    usuario_registro_id,
    estado_sincronizacion,
    acopiador_id,
    sector
)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    productor_id = excluded.productor_id,
    fecha_hora_epoch_millis = excluded.fecha_hora_epoch_millis,
    litros = excluded.litros,
    tipo = excluded.tipo,
    usuario_registro_id = excluded.usuario_registro_id,
    estado_sincronizacion = excluded.estado_sincronizacion,
    acopiador_id = excluded.acopiador_id,
    sector = excluded.sector;

obtenerEntregaPorId:
SELECT id, productor_id, fecha_hora_epoch_millis, litros, tipo,
       usuario_registro_id, estado_sincronizacion, acopiador_id, sector
FROM entrega_local
WHERE id = ?;

obtenerEntregas:
SELECT id, productor_id, fecha_hora_epoch_millis, litros, tipo,
       usuario_registro_id, estado_sincronizacion, acopiador_id, sector
FROM entrega_local
ORDER BY fecha_hora_epoch_millis DESC;

obtenerEntregasPorProductor:
SELECT id, productor_id, fecha_hora_epoch_millis, litros, tipo,
       usuario_registro_id, estado_sincronizacion, acopiador_id, sector
FROM entrega_local
WHERE productor_id = ?
ORDER BY fecha_hora_epoch_millis;

obtenerEntregasPorProductorYRango:
SELECT id, productor_id, fecha_hora_epoch_millis, litros, tipo,
       usuario_registro_id, estado_sincronizacion, acopiador_id, sector
FROM entrega_local
WHERE productor_id = ?
  AND fecha_hora_epoch_millis >= ?
  AND fecha_hora_epoch_millis < ?
ORDER BY fecha_hora_epoch_millis;

obtenerEntregasPorRango:
SELECT id, productor_id, fecha_hora_epoch_millis, litros, tipo,
       usuario_registro_id, estado_sincronizacion, acopiador_id, sector
FROM entrega_local
WHERE fecha_hora_epoch_millis >= ?
  AND fecha_hora_epoch_millis < ?
ORDER BY fecha_hora_epoch_millis;

actualizarEstadoEntrega:
UPDATE entrega_local
SET estado_sincronizacion = ?
WHERE id = ?;

guardarPruebaCalidad:
INSERT INTO prueba_calidad_local(id, entrega_id, fecha_hora_epoch_millis)
VALUES (?, ?, ?);

obtenerPruebaPorId:
SELECT * FROM prueba_calidad_local WHERE id = ?;

obtenerPruebaPorEntrega:
SELECT * FROM prueba_calidad_local WHERE entrega_id = ? ORDER BY id LIMIT 1;

obtenerPruebasPorRango:
SELECT * FROM prueba_calidad_local
WHERE fecha_hora_epoch_millis >= ? AND fecha_hora_epoch_millis < ?
ORDER BY fecha_hora_epoch_millis DESC;

obtenerTodasLasPruebas:
SELECT * FROM prueba_calidad_local ORDER BY fecha_hora_epoch_millis DESC;

guardarProblemaLeche:
INSERT INTO problema_leche_local(id, entrega_id, descripcion, fecha_hora_epoch_millis)
VALUES (?, ?, ?, ?);

obtenerProblemasPorEntrega:
SELECT * FROM problema_leche_local WHERE entrega_id = ? ORDER BY id;

obtenerProblemasPorRango:
SELECT * FROM problema_leche_local
WHERE fecha_hora_epoch_millis >= ? AND fecha_hora_epoch_millis < ?
ORDER BY fecha_hora_epoch_millis DESC;

obtenerTodosLosProblemas:
SELECT * FROM problema_leche_local ORDER BY fecha_hora_epoch_millis DESC;

guardarAuditoria:
INSERT INTO auditoria_local(
    id,
    usuario_id,
    fecha_hora_epoch_millis,
    registro_afectado_id,
    accion
)
VALUES (?, ?, ?, ?, ?)
ON CONFLICT(id) DO NOTHING;

obtenerAuditoriaPorId:
SELECT id, usuario_id, fecha_hora_epoch_millis, registro_afectado_id, accion
FROM auditoria_local
WHERE id = ?;

obtenerAuditorias:
SELECT id, usuario_id, fecha_hora_epoch_millis, registro_afectado_id, accion
FROM auditoria_local
ORDER BY fecha_hora_epoch_millis DESC, id DESC;

guardarEstadoSincronizacion:
INSERT INTO sincronizacion_local(tipo_registro, registro_id, estado)
VALUES (?, ?, ?)
ON CONFLICT(tipo_registro, registro_id) DO UPDATE SET estado = excluded.estado;

obtenerRegistrosSincronizacion:
SELECT registro_id, tipo_registro, estado
FROM sincronizacion_local
ORDER BY tipo_registro, registro_id;

obtenerPendientes:
SELECT registro_id, tipo_registro, estado
FROM sincronizacion_local
WHERE estado = 'PENDIENTE'
ORDER BY tipo_registro, registro_id;

obtenerEstadoSincronizacion:
SELECT estado
FROM sincronizacion_local
WHERE tipo_registro = ? AND registro_id = ?;

actualizarEstadoSincronizacion:
UPDATE sincronizacion_local
SET estado = ?
WHERE tipo_registro = ? AND registro_id = ?;

guardarLoteProduccion:
INSERT INTO lote_produccion_local(id, fecha_hora_epoch_millis, litros_utilizados, moldes_obtenidos, tipo_producto, observaciones)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    fecha_hora_epoch_millis = excluded.fecha_hora_epoch_millis,
    litros_utilizados = excluded.litros_utilizados,
    moldes_obtenidos = excluded.moldes_obtenidos,
    tipo_producto = excluded.tipo_producto,
    observaciones = excluded.observaciones;

obtenerLotePorId:
SELECT * FROM lote_produccion_local WHERE id = ?;

obtenerLotesProduccion:
SELECT * FROM lote_produccion_local ORDER BY fecha_hora_epoch_millis DESC;

obtenerLotesProduccionPorRango:
SELECT * FROM lote_produccion_local
WHERE fecha_hora_epoch_millis >= ? AND fecha_hora_epoch_millis < ?
ORDER BY fecha_hora_epoch_millis DESC;
